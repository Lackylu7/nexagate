# 只填域名，不要带 https://
APP_DOMAIN=nexagate.yourdomain.com

# 对外展示和 SDK 调用地址
PUBLIC_SITE_URL=https://nexagate.yourdomain.com
PUBLIC_API_BASE_URL=https://nexagate.yourdomain.com/v1
FRONTEND_BASE_URL=https://nexagate.yourdomain.com
TRUSTED_REDIRECT_DOMAINS=nexagate.yourdomain.com

# 管理员点击“进入后台”时打开的地址。
# 首次上线建议用 SSH 隧道访问本机端口：http://127.0.0.1:3000
# 如果后续要开放后台域名，再改成受保护的后台地址。
ADMIN_BACKEND_URL=http://127.0.0.1:3000

# 用户支持方式
SUPPORT_CONTACT=support@yourdomain.com

# 必须改成不同的强随机值。不要提交真实 .env。
NEXAGATE_SESSION_SECRET=replace_with_a_different_long_random_value
SESSION_SECRET=replace_with_a_long_random_value
CRYPTO_SECRET=replace_with_a_long_random_value
